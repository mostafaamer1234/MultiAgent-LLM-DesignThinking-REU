# Required for OpenAI-backed agents
OPENAI_API_KEY=

# Optional: better web search (https://tavily.com)
TAVILY_API_KEY=

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Web research: never enable in production — generates placeholder stats/URLs for demos only
ALLOW_SYNTHETIC_FALLBACK=false

# Models (override defaults)
OPENAI_MODEL_RESEARCH=gpt-4o-mini
OPENAI_MODEL_SYNTHESIS=gpt-4o

# API server
RESEARCH_LLM_DATABASE_URL=sqlite:////app/data/jobs.db
CORS_ORIGINS=http://localhost:3000
